@using SocOps.Models

<div class="hr-game-shell">
    <header class="hr-game-header">
        <button
            @onclick="OnReset"
            class="hr-ghost-btn">
            Exit Stage
        </button>
        <h1 class="hr-game-logo">Soc Ops</h1>
        <div class="hr-header-spacer"></div>
    </header>

    <p class="hr-game-instructions">
        Tag a square every time you meet someone who fits it.
    </p>

    @if (HasBingo)
    {
        <div class="hr-bingo-banner">
            BINGO UNLOCKED. THE CROWD IS LOUD.
        </div>
    }

    <div class="hr-board-wrap">
        <BingoBoard
            Board="@Board"
            WinningSquareIds="@WinningSquareIds"
            OnSquareClick="@OnSquareClick" />
    </div>
</div>

@code {
    [Parameter]
    public List<BingoSquareData> Board { get; set; } = new();

    [Parameter]
    public HashSet<int> WinningSquareIds { get; set; } = new();

    [Parameter]
    public bool HasBingo { get; set; }

    [Parameter]
    public EventCallback<int> OnSquareClick { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }
}
