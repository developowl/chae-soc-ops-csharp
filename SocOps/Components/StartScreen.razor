<div class="hr-start">
    <div class="hr-light-beam hr-light-left"></div>
    <div class="hr-light-beam hr-light-right"></div>

    <section class="hr-start-card">
        <p class="hr-kicker">LIVE TONIGHT</p>
        <h1 class="hr-title">SOC OPS</h1>
        <p class="hr-subtitle">SOCIAL BINGO STAGE EDITION</p>

        <div class="hr-rules-panel">
            <h2>How The Crowd Wins</h2>
            <ul>
                <li>Find people who match each square.</li>
                <li>Hit the square when you make a match.</li>
                <li>Own a 5-line streak and claim BINGO.</li>
            </ul>
        </div>

        <button
            @onclick="OnStart"
            class="hr-primary-btn">
            Drop The Needle
        </button>
    </section>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
