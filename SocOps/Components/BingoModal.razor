<div class="hr-modal-backdrop fixed inset-0 flex items-center justify-center p-4 z-50">
    <div class="hr-modal-card">
        <p class="hr-modal-kicker">Encore Moment</p>
        <h2>BINGO!</h2>
        <p class="hr-modal-copy">You just landed a perfect line. Keep the set rolling.</p>

        <button
            @onclick="OnDismiss"
            class="hr-primary-btn hr-modal-btn">
            Back To The Floor
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnDismiss { get; set; }
}
